---
import AffLink from './AffLink.astro';
import { SIDE_AD_AFF_ID, SIDE_AD_IMG } from '../data/article-banners.js';

/* カードとカードの間に入る広告枠。
   リンクは AffLink 経由（companies.json の affUrl → サイト内ページ の順で解決）。
   枠・背景・見出しは付けない。表示は 240×120 固定。 */
---
{SIDE_AD_AFF_ID && (
  <div class="side-ad">
    <AffLink id={SIDE_AD_AFF_ID} pos="sidebar-ad">
      <img src={SIDE_AD_IMG} width="240" height="120" alt="" loading="lazy" />
    </AffLink>
  </div>
)}
