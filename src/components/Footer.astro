---
import site from '../data/site.json';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <div class="footer-brand">
        <img
          src={`/images/brand/logo-white.png?v=${site.assetVersion}`}
          alt={site.name}
          width="2170" height="725"
          loading="lazy" decoding="async"
        />
      </div>
      <p>{site.description}</p>
    </div>
    {site.footer.map((col) => (
      <div>
        <h4>{col.head}</h4>
        <ul>
          {col.links.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer-bottom">© 2026 {site.name} All Rights Reserved. / 本サイトはアフィリエイトプログラムに参加しています。</div>
</footer>
