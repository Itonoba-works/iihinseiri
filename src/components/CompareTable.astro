---
import { emph } from '../lib/emph.js';
/* 比較表は companies.json から自動生成。20社になっても列は変わらない */
import companies from '../data/companies.json';
import AffLink from './AffLink.astro';
import { affFirst } from '../lib/aff.js';
const { category = 'ihin' } = Astro.props;
/* 提携済み（affUrl あり）を上位、未提携を下位に固定 */
const list = affFirst(companies.filter((c) => (c.categories || [c.category]).includes(category)));
---
<div class="table-wrap">
  <table class="compare-table cmp-rank">
    <thead>
      <tr>
        <th class="c-name">サービス名</th>
        <th class="c-type">サービス形態</th>
        <th class="c-btn">申し込み</th>
        <th class="c-price">料金の目安</th>
        <th class="c-area">対応エリア</th>
        <th class="c-feat">主な特徴</th>
      </tr>
    </thead>
    <tbody>
      {list.map((c) => (
        <tr class={c.top ? 'highlight' : undefined}>
          <th class="c-name"><AffLink id={c.id} pos="compare-name">{c.name}</AffLink></th>
          <td class="c-type">{c.shortType || c.serviceType}</td>
          <td class="c-btn">
            <AffLink id={c.id} class="btn-cta" pos="compare-btn">公式サイト</AffLink>
          </td>
          <td class="price-cell c-price" set:html={emph(c.shortPrice || c.price)} />
          <td class="c-area">{c.shortArea || c.area}</td>
          <td class="c-feat">{c.shortFeature || (c.features[0] || '')}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="table-hint">※料金は2026年11月時点の各社の掲載料金（税込）です。物量・階数・地域・時期などで変わります。</p>
