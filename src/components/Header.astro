---
import site from '../data/site.json';
import companies from '../data/companies.json';
import pages from '../data/pages.json';
const { active = '' } = Astro.props;

// 一括見積もりCTAの遷移先を companies.json から解決
// URLの管理場所は companies.json の該当社の affUrl / officialUrl
const est = companies.find((c) => c.id === site.estimateAffId);
const estUrl = est ? (est.affUrl || est.officialUrl || '') : '';
const estHref = estUrl
  ? estUrl
  : (est ? (est.hasReview ? '/reviews/' + est.id + '.html' : '/rankings/' + est.category + '.html#' + est.id) : '/rankings/ihin.html');

/* 「記事一覧」の下にぶら下げる記事ツリー。
   記事の唯一の正は pages.json なので、そこから生成する。
   記事を1本足せば site.json を触らなくてもナビに自動で増える。
   PCではドロップダウン、スマホのドロワーではアコーディオンになる。 */
const articleTree = pages
  .filter((p) => p.type === 'article')
  .slice()
  .reverse()
  .map((p) => ({
    href: '/articles/' + p.slug + '.html',
    label: String(p.h1 || '').replace(/【[^】]*】/g, '').trim()
  }));

/* site.json 側の「記事一覧」項目を判別する（key か href のどちらでも一致させる） */
const isArticles = (n) => n.key === 'articles' || n.href === '/articles.html';
---
<header class="site-header" data-screen-label="Header">
  <div class="header-top">
    <div class="header-top-inner">
      <span class="tagline">{site.tagline}</span>
      <time class="updated" data-today="更新日："></time>
    </div>
  </div>

  <div class="header-inner">
    <a href="/" class="site-logo" aria-label={site.name}>
      <img
        src={`/images/brand/logo.png?v=${site.assetVersion}`}
        alt={site.name}
        width="2170" height="725"
        fetchpriority="high" decoding="async"
      />
    </a>

    <nav class="site-nav" aria-label="メインナビゲーション">
      {site.nav.map((n) =>
        isArticles(n) ? (
          <div class="nav-item has-sub">
            <a
              href={n.href}
              class={n.key === active ? 'active' : undefined}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="navArticleTree"
            >{n.label}<span class="caret" aria-hidden="true"></span></a>
            <div class="nav-sub" id="navArticleTree">
              <a href={n.href} class="nav-sub-all">記事一覧をすべて見る</a>
              {articleTree.map((a) => (<a href={a.href}>{a.label}</a>))}
            </div>
          </div>
        ) : (
          <a href={n.href} class={n.key === active ? 'active' : undefined}>{n.label}</a>
        )
      )}
    </nav>

    <a
      href={estHref}
      class="header-cta pulse"
      data-aff={est ? est.id : undefined}
      data-aff-external={estUrl ? true : undefined}
      data-aff-pos="header"
      rel={estUrl ? 'sponsored nofollow noopener' : undefined}
      target={estUrl ? '_blank' : undefined}
    >{site.estimateLabel}</a>

    <button class="nav-toggle" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="navDrawer">
      <i></i><i></i><i></i>
    </button>
  </div>
</header>

<div class="nav-drawer" id="navDrawer">
  <div class="nav-drawer-panel">
    <div class="nav-drawer-head">
      <span class="t">カテゴリを選ぶ</span>
      <button class="nav-drawer-close" type="button" aria-label="メニューを閉じる">×</button>
    </div>
    {site.drawer.map((n) =>
      isArticles(n) ? (
        <div class="d-group">
          <button class="d-item d-toggle" type="button" aria-expanded="false" aria-controls="drawerArticleTree">
            {n.label}<span class="chev" aria-hidden="true">›</span>
          </button>
          <div class="d-sub" id="drawerArticleTree">
            <a href={n.href} class="d-sub-all">記事一覧をすべて見る</a>
            {articleTree.map((a) => (<a href={a.href}>{a.label}</a>))}
          </div>
        </div>
      ) : (
        <a href={n.href} class="d-item">{n.label}<span class="chev">›</span></a>
      )
    )}
    <a
      href={estHref}
      class="btn-cta full drawer-cta pulse"
      data-aff={est ? est.id : undefined}
      data-aff-external={estUrl ? true : undefined}
      data-aff-pos="drawer"
      rel={estUrl ? 'sponsored nofollow noopener' : undefined}
      target={estUrl ? '_blank' : undefined}
    >{site.estimateLabel}</a>
  </div>
</div>
