---
import { emph } from '../lib/emph.js';
import companies from '../data/companies.json';
import pages from '../data/pages.json';
import KeyPoints from './KeyPoints.astro';
import AffLink from './AffLink.astro';
import SidebarAd from './SidebarAd.astro';
import { affFirst } from '../lib/aff.js';
import { relatedArticles } from '../lib/related.js';

const { keyPoints = [], category = 'ihin', currentSlug = '', showSideAd = false, page = null } = Astro.props;
const ranked = affFirst(companies.filter((c) => (c.categories || [c.category]).includes(category))).slice(0, 11);
const catLabel = category === 'cleaning' ? 'ハウスクリーニング' : '遺品整理・不用品回収';
/* 関連記事：内容が近い記事を選ぶ（src/lib/related.js）。以前は全ページ同じ4本だった */
const related = relatedArticles(page || pages.find((p) => p.slug === currentSlug) || { slug: currentSlug }, { category, max: 4 });
---
<aside class="side">
  <div class="side-sticky">
    <KeyPoints points={keyPoints} />

    {showSideAd && <SidebarAd />}

    <div class="side-block">
      <h4>{catLabel} {ranked.length}社</h4>
      {ranked.map((c, i) => (
        <AffLink id={c.id} class="side-rank-item" pos="sidebar">
          <div class="side-rank-num">{i + 1}</div>
          <div>
            <div class="n">{c.name}</div>
            <div class="s" set:html={emph(c.shortPrice || c.price)} />
          </div>
        </AffLink>
      ))}
    </div>

    <div class="side-block">
      <h4>関連記事</h4>
      {related.map((p) => (
        <a href={'/articles/' + p.slug + '.html'} class="side-rank-item" style="grid-template-columns:1fr;">
          <div class="n">{p.h1}</div>
        </a>
      ))}
    </div>
  </div>
</aside>
