---
import WpSideNav from '../components/WpSideNav.astro';
/* 期限カレンダー（/kigen.html）。SNSなどで共有する単独ページ。
   カレンダー本体は src/content/parts/kigen-tool.html（記事「親が亡くなった後の手続き」と共通） */
import Base from '../layouts/Base.astro';
import StickyCta from '../components/StickyCta.astro';
import kigenTool from '../content/parts/kigen-tool.html?raw';

const abs = (href) => new URL(href, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'HOME', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: '期限カレンダー', item: abs('/kigen.html') }
    ]
  }
];
---
<Base
  title="期限カレンダー｜親が亡くなった後の手続きの期限を、亡くなった日から一覧で"
  description="亡くなった日を入れるだけで、死亡届（7日以内）、国民健康保険・世帯主の変更（14日以内）、相続放棄（3か月）、準確定申告（4か月）、相続税（10か月）、相続登記（3年）の期限の目安日と残り日数を一覧で表示します。"
  active="tools"
  pageCss="home.css,page-checklist.css"
  jsonLd={jsonLd}
>
  <div class="breadcrumb" slot="breadcrumb">
    <a href="/">HOME</a>
    <span class="sep">›</span>
    <span>期限カレンダー</span>
  </div>

  <div class="container wp-layout ck-layout">
  <main class="wp-main ck">
    <h1>期限カレンダー<br />親が亡くなった後の手続きの期限を一覧で</h1>
    <p class="ck-lead">親が亡くなると、届出や申告の期限が7日・14日・3か月・10か月と続きます。<strong>亡くなった日を入れるだけで、手続きごとの期限の目安日と残り日数</strong>が並びます。どの手続きから手を付ければよいかの目安にしてください。</p>

    <div class="article-body kigen-page" set:html={kigenTool} />

    <div class="kigen-links">
      <h2>あわせて読む</h2>
      <ul>
        <li><a href="/articles/ihin-itsukara.html">親が亡くなった後の手続きと遺品整理の順番</a>：各手続きの届出先と、遺品整理を始める時期</li>
        <li><a href="/articles/keiyaku-kaiyaku.html">親が亡くなった後の契約解約</a>：携帯電話・電気・ガス・NHKの手続き</li>
        <li><a href="/articles/souzoku-houki.html">相続放棄と遺品整理</a>：3か月の期限と、遺品の扱いで気をつけること</li>
        <li><a href="/checklist.html">実家じまいチェックリスト</a>：親が元気なうちに確認しておきたい27項目</li>
      </ul>
    </div>

    <p class="ck-source">出典：法務省「死亡届」「相続登記の申請義務化」、日本年金機構「年金を受けている方が亡くなったとき」、東京都保健医療局「国民健康保険の加入・喪失手続」、大阪市「世帯変更届」、裁判所「相続の放棄の申述」、国税庁 タックスアンサー No.2022・No.4205。</p>
  </main>
    <WpSideNav />
  </div>

  <StickyCta slot="cta" />
</Base>
