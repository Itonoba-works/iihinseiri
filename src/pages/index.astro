---
import { emph } from '../lib/emph.js';
import Base from '../layouts/Base.astro';
import StickyCta from '../components/StickyCta.astro';
import AffLink from '../components/AffLink.astro';
import WpSideNav from '../components/WpSideNav.astro';
import site from '../data/site.json';
import companies from '../data/companies.json';
import pages from '../data/pages.json';
import areaData from '../data/areas.json';
import { affFirst } from '../lib/aff.js';

/* 新着・人気記事：pages.json の後ろほど新しい。最大6件 */
const NEW_MAX = 6;
/* 1枠に表示する最大社数（残りは比較表へ） */
const LIST_MAX = site.topListMax || 5;

const articles = pages.filter((p) => p.type === 'article').slice().reverse().slice(0, NEW_MAX);
const shortTitle = (t) => String(t || '').replace(/【[^】]*】/g, '').trim();

const topics = [
  { href: '/rankings/ihin.html', title: '遺品整理', desc: '故人の遺品を丁寧に', img: 'ihin-price' },
  { href: '/articles/seizen.html', title: '生前整理', desc: '元気なうちに始める', img: 'seizen' },
  { href: '/articles/huyouhin.html', title: '不用品回収', desc: '大量処分もOK', img: 'huyouhin' },
  { href: '/rankings/cleaning.html', title: 'ハウスクリーニング', desc: '空き家・引越し前に', img: 'cleaning' }
];


/* 対応エリア：type が list の業者だけ、prefs 以外の県で非表示（outside:consult なら常に表示） */
const areaAttr = (c) => {
  const a = areaData.companies[c.id];
  if (!a || a.type !== 'list' || a.outside === 'consult') return 'all';
  return a.prefs.join(',');
};
const detailHref = (c) => (c.hasReview ? '/reviews/' + c.id + '.html' : '/rankings/' + c.category + '.html#' + c.id);

const blocks = [
  { cat: 'ihin', title: '遺品整理・不用品回収', href: '/rankings/ihin.html' },
  { cat: 'cleaning', title: 'ハウスクリーニング', href: '/rankings/cleaning.html' }
].map((b) => ({ ...b, list: affFirst(companies.filter((c) => (c.categories || [c.category]).includes(b.cat))) }));

const homeUrl = new URL('/', Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: site.nameEn,
    url: homeUrl,
    description: site.description,
    inLanguage: 'ja'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: homeUrl,
    logo: { '@type': 'ImageObject', url: new URL('/images/brand/logo.png', Astro.site).href },
    description: site.tagline
  }
];
---
<Base
  title="くらしの整理ナビ｜遺品整理・実家の片付け・ハウスクリーニングの業者比較"
  active="home"
  pageCss="home.css"
  ogType="website"
  jsonLd={jsonLd}
>
  <section class="wp-hero" data-screen-label="Hero">
    <div class="container">
      <h1>遺品整理・実家の片付け・ハウスクリーニングの業者比較</h1>
      <p class="wp-hero-sub">お住まいの地域に対応している業者を、料金とあわせて比べられます。</p>
      <form class="wp-search" id="siteSearch" role="search" action="/" method="get">
        <input type="search" id="q" name="q" placeholder="キーワードで探す（例：エアコン、ゴミ屋敷、相続）" aria-label="サイト内検索" autocomplete="off" />
        <button type="submit">検索</button>
      </form>
    </div>
  </section>

  <div class="container wp-layout">
    <main class="wp-main">
      <section class="wp-sec" id="searchResults" hidden>
        <h2 class="wp-h2" id="searchTitle">検索結果</h2>
        <ul class="wp-results" id="searchList"></ul>
        <button type="button" class="wp-clear" id="searchClear">検索をやめる</button>
      </section>

      <section class="wp-sec" data-screen-label="カテゴリから探す">
        <h2 class="wp-h2">カテゴリから探す</h2>
        <div class="wp-cats">
          {topics.map((t) => (
            <a href={t.href} class="wp-cat">
              <span class="label">{t.title}</span>
              <span class="desc">{t.desc}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="wp-sec" data-screen-label="ツール">
        <h2 class="wp-h2">チェックリスト（保存版）</h2>
        <a href="/checklist.html" class="wp-tool">
          <span class="ttl">保存用チェックリスト～親が元気なうちに～</span>
          <span class="desc">お金・家・モノ・人・段取り・契約とデジタルの6分類。印刷して親と一緒に埋められます。</span>
        </a>
      </section>

      <section class="wp-sec" id="gyousha" data-screen-label="地域から探す">
        <h2 class="wp-h2" id="gyoushaTitle">地域から探す</h2>
        <form class="wp-area" id="areaForm">
          <label for="prefSel">片付け・清掃をしたい家の場所</label>
          <select id="prefSel" aria-label="都道府県を選ぶ">
            <option value="">都道府県を選ぶ</option>
            {areaData.regions.map((r) => (
              <optgroup label={r.name}>
                {r.prefs.map((p) => <option value={p}>{p}</option>)}
              </optgroup>
            ))}
          </select>
          <button type="submit" class="wp-area-go" id="prefGo" disabled>この地域で探す</button>
          <button type="button" class="hm-reset" id="prefReset" hidden>地域の選択を解除</button>
        </form>
        <p class="wp-area-help" id="gyoushaSub">実家など、お住まいと別の場所でも選べます。</p>
        <div class="wp-area-result" id="cmpWrap" hidden>
          <div class="wp-tabs" role="tablist" aria-label="カテゴリ">
            {blocks.map((b, i) => (
              <button type="button" role="tab" class="wp-tab" data-tab={b.cat} aria-selected={i === 0 ? 'true' : 'false'}>
                {b.title}<span class="cnt" />
              </button>
            ))}
          </div>
          {blocks.map((b, i) => (
            <div class="hm-cmp wp-area-col" data-block={b.cat} role="tabpanel" hidden={i !== 0}>
              <h3>{b.title}</h3>
              <ul>
                {b.list.map((c) => (
                  <li class="hm-cmp-row wp-co" data-areas={areaAttr(c)}>
                    <span class="txt">
                      <AffLink id={c.id} class="nm" pos={'top-' + b.cat + '-name'}>{c.name}</AffLink>
                      <span class="pr-line" set:html={emph(c.shortPrice || c.price)} />
                    </span>
                    <a href={detailHref(c)} class="wp-detail" data-detail={c.id} data-aff-pos={'top-' + b.cat + '-detail'}>徹底解説</a>
                  </li>
                ))}
              </ul>
              <div class="hm-cmp-empty" hidden>この地域に対応している掲載業者はありません。</div>
              <a href={b.href} class="wp-more">{b.title}の比較表を見る</a>
            </div>
          ))}
        </div>
      </section>

      <section class="wp-sec" data-screen-label="新着記事">
        <h2 class="wp-h2">新着記事</h2>
        <div class="wp-grid">
          {articles.map((a) => (
            <a href={'/articles/' + a.slug + '.html'} class="wp-card">
              <span class="thumb">
                <img src={'/images/articles/' + a.slug + '.webp'} alt="" width="800" height="500" loading="lazy" decoding="async" onerror="this.style.display='none'" />
                {a.catTag && <span class="cat">{String(a.catTag).split('／')[0]}</span>}
              </span>
              <span class="ttl">{shortTitle(a.h1)}</span>
            </a>
          ))}
        </div>
        <a href="/articles.html" class="wp-more">記事一覧を見る</a>
      </section>

      <p class="hm-note">料金・対応エリアは変わることがあります。依頼前に各社サイトで最新情報をご確認ください。</p>
    </main>

    <WpSideNav tagSearch={true} />
  </div>

  <StickyCta slot="cta" />

<script is:inline define:vars={{ LIST_MAX }}>
(function () {
  var LS_KEY = 'kurashi-pref';
  var sel = document.getElementById('prefSel');
  var form = document.getElementById('areaForm');
  var reset = document.getElementById('prefReset');
  var title = document.getElementById('gyoushaTitle');
  var sub = document.getElementById('gyoushaSub');
  var wrap = document.getElementById('cmpWrap');
  if (!sel || !wrap) return;
  var first = true;

  var go = document.getElementById('prefGo');
  var counts = {};
  function render(pref) {
    title.textContent = pref ? pref + 'に対応している業者' : '地域から探す';
    reset.hidden = !pref;
    wrap.hidden = !pref;
    wrap.classList.remove('is-swap');
    wrap.querySelectorAll('.hm-cmp').forEach(function (block) {
      var n = 0;
      block.querySelectorAll('.hm-cmp-row').forEach(function (row) {
        var areas = row.getAttribute('data-areas');
        var ok = !pref || areas === 'all' || areas.split(',').indexOf(pref) !== -1;
        var show = ok && n < LIST_MAX;
        row.hidden = !show;
        if (show) { row.style.setProperty('--i', n); n++; }
      });
      block.querySelector('.hm-cmp-empty').hidden = n > 0;
      var tab = wrap.querySelector('.wp-tab[data-tab="' + block.getAttribute('data-block') + '"] .cnt');
      if (tab) tab.textContent = '（' + n + '社）';
      counts[block.getAttribute('data-block')] = n;
    });
    var labels = { ihin: '遺品整理・不用品回収', cleaning: 'ハウスクリーニング' };
    sub.textContent = pref
      ? pref + 'で、' + Object.keys(counts).map(function (k) { return (labels[k] || k) + ' ' + counts[k] + '社'; }).join('、') + 'が見つかりました。'
      : '実家など、お住まいと別の場所でも選べます。';
    sub.classList.toggle('is-result', !!pref);
    go.disabled = true;
    if (!first) { void wrap.offsetWidth; wrap.classList.add('is-swap'); }
    first = false;
  }

  var saved = '';
  try { saved = localStorage.getItem(LS_KEY) || ''; } catch (e) {}
  if (saved) sel.value = saved;
  render(sel.value);

  function save(v) { try { v ? localStorage.setItem(LS_KEY, v) : localStorage.removeItem(LS_KEY); } catch (e) {} }

  /* タブ：遺品整理／ハウスクリーニングを切り替える。スクロール中はタブだけ上部に残る */
  var tabs = wrap.querySelector('.wp-tabs');
  wrap.querySelectorAll('.wp-tab').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cat = btn.getAttribute('data-tab');
      wrap.querySelectorAll('.wp-tab').forEach(function (t) { t.setAttribute('aria-selected', t === btn ? 'true' : 'false'); });
      wrap.querySelectorAll('.wp-area-col').forEach(function (col) { col.hidden = col.getAttribute('data-block') !== cat; });
      var top = wrap.getBoundingClientRect().top + window.pageYOffset - 60;
      if (window.pageYOffset > top) window.scrollTo({ top: top, behavior: 'smooth' });
    });
  });

  /* 都道府県を選んでから「この地域で探す」を押して結果を出す（選んだだけでは切り替えない） */
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!sel.value) return;
    save(sel.value);
    render(sel.value);
    var top = document.getElementById('gyousha').getBoundingClientRect().top + window.pageYOffset - 70;
    window.scrollTo({ top: top, behavior: 'smooth' });
    if (window.dataLayer) window.dataLayer.push({ event: 'area_search', area: sel.value });
  });
  sel.addEventListener('change', function () {
    go.disabled = !sel.value;
    if (!wrap.hidden) {
      /* 前の結果を残すと、どの都道府県の結果か分からなくなるため、いったん隠す */
      wrap.hidden = true;
      title.textContent = '地域から探す';
      sub.textContent = '「この地域で探す」を押すと、対応している業者が表示されます。';
      sub.classList.remove('is-result');
    }
  });
  reset.addEventListener('click', function () { sel.value = ''; save(''); render(''); });
})();
</script>

<script is:inline>
(function () {
  var form = document.getElementById('siteSearch');
  var input = document.getElementById('q');
  var box = document.getElementById('searchResults');
  var list = document.getElementById('searchList');
  var title = document.getElementById('searchTitle');
  var clear = document.getElementById('searchClear');
  if (!form || !input) return;
  var index = null;
  function load() {
    if (index) return Promise.resolve(index);
    return fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { index = d; return d; });
  }
  function norm(s) { return String(s || '').toLowerCase().normalize('NFKC'); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function run(q) {
    q = String(q || '').trim();
    if (!q) { box.hidden = true; return; }
    load().then(function (items) {
      var terms = norm(q).split(/[\s　]+/).filter(Boolean);
      var hits = items.filter(function (it) {
        var hay = norm(it.t + ' ' + it.d + ' ' + it.x);
        return terms.every(function (t) { return hay.indexOf(t) !== -1; });
      });
      title.textContent = '「' + q + '」の検索結果（' + hits.length + '件）';
      list.innerHTML = hits.length
        ? hits.map(function (it) { return '<li><a href="' + esc(it.u) + '"><span class="th"><img src="' + esc(it.i || '/images/hero.webp') + '" alt="" loading="lazy" decoding="async" /></span><span class="bd"><span class="k">' + esc(it.k) + '</span><span class="t">' + esc(it.t) + '</span><span class="d">' + esc(it.d) + '</span></span></a></li>'; }).join('')
        : '<li class="none">該当するページはありませんでした。別のキーワードでお試しください。</li>';
      box.hidden = false;
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (window.dataLayer) window.dataLayer.push({ event: 'site_search', search_term: q });
    });
  }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var q = input.value;
    history.replaceState(null, '', q.trim() ? '/?q=' + encodeURIComponent(q.trim()) : '/');
    run(q);
  });
  document.querySelectorAll('[data-q]').forEach(function (a) {
    a.addEventListener('click', function (e) { e.preventDefault(); input.value = a.getAttribute('data-q'); form.requestSubmit(); });
  });
  clear.addEventListener('click', function () { input.value = ''; history.replaceState(null, '', '/'); box.hidden = true; });
  var init = new URLSearchParams(location.search).get('q');
  if (init) { input.value = init; run(init); }
})();
</script>
</Base>
