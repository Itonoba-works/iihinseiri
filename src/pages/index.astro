---
import Base from '../layouts/Base.astro';
import StickyCta from '../components/StickyCta.astro';
import AffLink from '../components/AffLink.astro';
import site from '../data/site.json';
import companies from '../data/companies.json';
import pages from '../data/pages.json';
import areaData from '../data/areas.json';

/* 新着・人気記事：pages.json の後ろほど新しい。最大6件 */
const NEW_MAX = 6;
/* 1枠に表示する最大社数（残りは比較表へ） */
const LIST_MAX = 5;

const articles = pages.filter((p) => p.type === 'article').slice().reverse().slice(0, NEW_MAX);
const shortTitle = (t) => String(t || '').replace(/【[^】]*】/g, '').trim();

const topics = [
  { href: '/rankings/ihin.html', title: '遺品整理', desc: '故人の遺品を丁寧に' },
  { href: '/articles/seizen.html', title: '生前整理', desc: '元気なうちに始める' },
  { href: '/articles/huyouhin.html', title: '不用品回収', desc: '大量処分もOK' },
  { href: '/rankings/cleaning.html', title: 'ハウスクリーニング', desc: '空き家・引越し前に' }
];

const worries = [
  '実家の遺品整理、何から手をつけていいかわからない',
  '業者の相場がわからず、ぼったくられそうで不安',
  '仕事があって現地に行けない・遠方に住んでいる',
  '故人の思い出の品を大切に扱ってほしい',
  '大量の不用品を一気に処分したい',
  '女性スタッフに対応してもらいたい'
];

/* 対応エリア：type が list の業者だけ、prefs 以外の県で非表示（outside:consult なら常に表示） */
const areaAttr = (c) => {
  const a = areaData.companies[c.id];
  if (!a || a.type !== 'list' || a.outside === 'consult') return 'all';
  return a.prefs.join(',');
};
const detailHref = (c) => (c.hasReview ? '/reviews/' + c.id + '.html' : '/rankings/' + c.category + '.html#' + c.id);

const blocks = [
  { cat: 'ihin', title: '遺品整理・不用品回収', href: '/rankings/ihin.html' },
  { cat: 'cleaning', title: 'ハウスクリーニング', href: '/rankings/cleaning.html' }
].map((b) => ({ ...b, list: companies.filter((c) => c.category === b.cat) }));

const homeUrl = new URL('/', Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: site.nameEn,
    url: homeUrl,
    description: site.description,
    inLanguage: 'ja'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: homeUrl,
    logo: { '@type': 'ImageObject', url: new URL('/images/brand/logo.png', Astro.site).href },
    description: site.tagline
  }
];
---
<Base
  title="くらしの整理ナビ｜遺品整理・実家の片付け・ハウスクリーニングの業者比較"
  active="home"
  pageCss="home.css"
  ogType="website"
  jsonLd={jsonLd}
>
  <section class="hm-hero" data-screen-label="Hero">
    <div class="hm-hero-inner">
      <div class="hm-hero-copy">
        <h1>遺品整理・実家の片付け・<br />ハウスクリーニングの業者比較</h1>
        <p class="hm-hero-sub">お住まいの地域に対応している業者を、料金とあわせて比べられます。</p>
        <form class="hm-area-form" id="areaForm">
          <label for="prefSel">片付け・清掃をしたい家の場所</label>
          <div class="hm-area-row">
            <select id="prefSel" aria-label="都道府県を選ぶ">
              <option value="">都道府県を選ぶ</option>
              {areaData.regions.map((r) => (
                <optgroup label={r.name}>
                  {r.prefs.map((p) => <option value={p}>{p}</option>)}
                </optgroup>
              ))}
            </select>
            <button type="submit" class="btn-search">対応業者を見る</button>
          </div>
          <p class="hm-area-help">実家など、お住まいと別の場所でも選べます。</p>
        </form>
      </div>
      <div class="hm-hero-img">
        <img src="/images/hero.webp" alt="明るい部屋で片付けをする様子" width="1200" height="900" decoding="async" fetchpriority="high" onerror="this.style.display='none'" />
      </div>
    </div>
  </section>

  <main class="container">
    <section class="hm-sec" id="gyousha" data-screen-label="対応業者">
      <div class="section-head" data-reveal="0">
        <h2 id="gyoushaTitle">業者を比較する</h2>
        <p id="gyoushaSub">都道府県を選ぶと、対応している業者だけを表示します。</p>
        <button type="button" class="hm-reset" id="prefReset" hidden>地域の選択を解除</button>
      </div>
      <div class="hm-compare" id="cmpWrap" data-reveal="1">
        {blocks.map((b) => (
          <div class="hm-cmp" data-block={b.cat}>
            <div class="hm-cmp-head"><h3>{b.title}</h3></div>
            {b.list.map((c) => (
              <div class="hm-cmp-row" data-areas={areaAttr(c)}>
                <div>
                  <div class="n">
                    <AffLink id={c.id} pos={'top-' + b.cat + '-name'}>{c.name}</AffLink>
                    {c.hasReview && <a href={'/reviews/' + c.id + '.html'} class="rv">レビュー</a>}
                  </div>
                  <div class="s">{c.shortPrice || c.price}</div>
                </div>
                <a href={detailHref(c)} class="btn-detail" data-detail={c.id} data-aff-pos={'top-' + b.cat + '-detail'}>詳細はこちら</a>
              </div>
            ))}
            <div class="hm-cmp-empty" hidden>この地域に対応している掲載業者はありません。</div>
            <div class="hm-cmp-foot"><a href={b.href} class="btn-secondary">比較表を見る</a></div>
          </div>
        ))}
      </div>
      <p class="hm-area-note">対応エリアは各社サイトの記載（2026年9月時点）によります。詳しい対応地域は各社にご確認ください。</p>
    </section>

    <section class="hm-sec" data-screen-label="お悩み別に探す">
      <div class="section-head" data-reveal="0"><h2>お悩み別に探す</h2></div>
      <div class="topic-list">
        {topics.map((t, i) => (
          <a href={t.href} class="topic-list-item" data-reveal={String(i)}>
            <div class="title">{t.title}</div>
            <div class="desc">{t.desc}</div>
          </a>
        ))}
      </div>
      <div class="worries" data-reveal="0">
        <h3>こんなお悩み、ありませんか？</h3>
        <div class="worry-list">
          {worries.map((w) => <div class="worry-item">{w}</div>)}
        </div>
        <p class="worries-note">料金・対応エリア・特徴の3点で比較すれば、依頼先は絞り込めます。</p>
      </div>
    </section>

    <section class="hm-sec" data-screen-label="新着・人気記事">
      <div class="section-head" data-reveal="0"><h2>新着・人気記事</h2></div>
      <div class="hm-cards">
        {articles.map((a, i) => (
          <a href={'/articles/' + a.slug + '.html'} class="article-card" data-reveal={String(i)}>
            <div class="thumb">
              <img src={'/images/articles/' + a.slug + '.webp'} alt="" width="800" height="500" loading="lazy" decoding="async" onerror="this.style.display='none'" />
              <div class="ph">[ {a.catTag} ]</div>
            </div>
            <div class="body"><h3>{shortTitle(a.h1)}</h3></div>
          </a>
        ))}
      </div>
      <div class="hm-all"><a href="/articles.html" class="btn-secondary">すべての記事を見る</a></div>
    </section>

    <p class="hm-note">料金・対応エリアは変わることがあります。依頼前に各社サイトで最新情報をご確認ください。</p>
  </main>

  <StickyCta slot="cta" />

<script is:inline define:vars={{ LIST_MAX }}>
(function () {
  var LS_KEY = 'kurashi-pref';
  var sel = document.getElementById('prefSel');
  var form = document.getElementById('areaForm');
  var reset = document.getElementById('prefReset');
  var title = document.getElementById('gyoushaTitle');
  var sub = document.getElementById('gyoushaSub');
  var wrap = document.getElementById('cmpWrap');
  if (!sel || !wrap) return;
  var first = true;

  function render(pref) {
    title.textContent = pref ? pref + 'に対応している業者' : '業者を比較する';
    sub.textContent = pref ? 'この地域に対応している業者を表示しています。' : '都道府県を選ぶと、対応している業者だけを表示します。';
    reset.hidden = !pref;
    wrap.classList.remove('is-swap');
    wrap.querySelectorAll('.hm-cmp').forEach(function (block) {
      var n = 0;
      block.querySelectorAll('.hm-cmp-row').forEach(function (row) {
        var areas = row.getAttribute('data-areas');
        var ok = !pref || areas === 'all' || areas.split(',').indexOf(pref) !== -1;
        var show = ok && n < LIST_MAX;
        row.hidden = !show;
        if (show) { row.style.setProperty('--i', n); n++; }
      });
      block.querySelector('.hm-cmp-empty').hidden = n > 0;
    });
    if (!first) { void wrap.offsetWidth; wrap.classList.add('is-swap'); }
    first = false;
  }

  var saved = '';
  try { saved = localStorage.getItem(LS_KEY) || ''; } catch (e) {}
  if (saved) sel.value = saved;
  render(sel.value);

  function save(v) { try { v ? localStorage.setItem(LS_KEY, v) : localStorage.removeItem(LS_KEY); } catch (e) {} }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    save(sel.value);
    render(sel.value);
    if (sel.value) {
      var top = document.getElementById('gyousha').getBoundingClientRect().top + window.pageYOffset - 90;
      window.scrollTo({ top: top, behavior: 'smooth' });
    }
  });
  sel.addEventListener('change', function () { save(sel.value); render(sel.value); });
  reset.addEventListener('click', function () { sel.value = ''; save(''); render(''); });
})();
</script>
</Base>
