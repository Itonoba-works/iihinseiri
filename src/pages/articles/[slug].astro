---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import AdArticleMid from '../../components/AdArticleMid.astro';
import pages from '../../data/pages.json';

const bodies = import.meta.glob('../../content/articles/*.html', { query: '?raw', import: 'default', eager: true });

export function getStaticPaths() {
  return pages
    .filter((p) => p.type === 'article')
    .map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props;
const key = Object.keys(bodies).find((k) => k.endsWith('/' + page.slug + '.html'));
const rawBody = key ? bodies[key] : '';

/* 中段の広告枠。本文の見出し（h2）の中間地点にマーカーを1つだけ置き、
   その位置に ArticleLayout が <slot name="mid-cta"> を描画する。
   本文は set:html で流し込む文字列なのでコンポーネントを直接差し込めない。 */
const MID_MARK = '<!--mid-cta-->';

function withMidMarker(html) {
  if (!html) return html;
  const hits = [];
  const re = /<h2[\s>]/g;
  let m;
  while ((m = re.exec(html)) !== null) hits.push(m.index);
  /* 見出しが2つ以下の短い本文には入れない */
  if (hits.length < 3) return html;
  const at = hits[Math.floor(hits.length / 2)];
  return html.slice(0, at) + MID_MARK + html.slice(at);
}

const body = withMidMarker(rawBody);

const active = page.slug === 'ihin-price' || page.slug === 'huyouhin' ? 'price' : 'nayami';
const category = page.slug === 'huyouhin' ? 'ihin' : 'ihin';

---
<ArticleLayout
  page={page}
  body={body}
  active={active}
  category={category}
  pageCss="page-article.css"
  breadcrumb={[{ label: page.catTag || '記事' }]}
  sideAd
>
  <div slot="mid-cta">
    <AdArticleMid />
  </div>
</ArticleLayout>
