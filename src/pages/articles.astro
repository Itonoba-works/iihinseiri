---
/* 記事一覧 /articles.html
   pages.json の type:article を新しい順（後ろほど新しい）にすべて並べる。
   TOPの「すべての記事を見る」とヘッダーの「記事一覧」のリンク先 */
import Base from '../layouts/Base.astro';
import StickyCta from '../components/StickyCta.astro';
import WpSideNav from '../components/WpSideNav.astro';
import pages from '../data/pages.json';

const articles = pages.filter((p) => p.type === 'article').slice().reverse();
const shortTitle = (t) => String(t || '').replace(/【[^】]*】/g, '').trim();
const abs = (href) => new URL(href, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'HOME', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: '記事一覧', item: abs('/articles.html') }
    ]
  }
];
---
<Base
  title="記事一覧"
  description="遺品整理・実家の片付け・相続・生前整理・不用品回収・ハウスクリーニングに関する記事の一覧です。"
  active="articles"
  pageCss="home.css"
  jsonLd={jsonLd}
>
  <div class="breadcrumb" slot="breadcrumb">
    <a href="/">HOME</a>
    <span class="sep">›</span>
    <span>記事一覧</span>
  </div>

  <div class="container wp-layout">
    <main class="wp-main">
      <h1 class="wp-h2 wp-page-title">記事一覧</h1>
      <form class="wp-search wp-search-sm" role="search" action="/" method="get">
        <input type="search" name="q" placeholder="キーワードで探す（例：エアコン、ゴミ屋敷、相続）" aria-label="サイト内検索" autocomplete="off" />
        <button type="submit">検索</button>
      </form>
      <div class="wp-grid">
        {articles.map((a) => (
          <a href={'/articles/' + a.slug + '.html'} class="wp-card">
            <span class="thumb">
              <img src={'/images/articles/' + a.slug + '.webp'} alt="" width="800" height="500" loading="lazy" decoding="async" onerror="this.style.display='none'" />
              {a.catTag && <span class="cat">{String(a.catTag).split('／')[0]}</span>}
            </span>
            <span class="ttl">{shortTitle(a.h1)}</span>
          </a>
        ))}
      </div>
    </main>
    <WpSideNav />
  </div>

  <StickyCta slot="cta" />
</Base>
