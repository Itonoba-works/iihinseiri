---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import AffLink from '../../components/AffLink.astro';
import pages from '../../data/pages.json';
import companies from '../../data/companies.json';

const bodies = import.meta.glob('../../content/reviews/*.html', { query: '?raw', import: 'default', eager: true });

export function getStaticPaths() {
  /* companies.json に載っている全社分を生成。本文(.html)が無い社も
     料金表とCTAだけのページとして成立する */
  return companies.map((c) => {
    const meta = pages.find((p) => p.type === 'review' && p.slug === c.id);
    const page = meta || {
      slug: c.id,
      type: 'review',
      title: c.name + 'の料金・特徴・対応エリアを整理',
      description: c.name + 'の料金・対応エリア・特徴をまとめました。',
      catTag: c.category === 'cleaning' ? 'ハウスクリーニング' : '遺品整理・不用品回収',
      h1: c.name + 'の料金・特徴・対応エリアを整理',
      meta: [],
      keyPoints: []
    };
    return { params: { slug: c.id }, props: { page, company: c } };
  });
}

const { page, company } = Astro.props;
const key = Object.keys(bodies).find((k) => k.endsWith('/' + page.slug + '.html'));
const rawBody = key ? bodies[key] : '';
const keyPoints = (page.keyPoints && page.keyPoints.length)
  ? page.keyPoints
  : [company.shortType && 'サービス形態：' + company.shortType, company.shortPrice && '料金目安：' + company.shortPrice, company.shortArea && '対応エリア：' + company.shortArea].filter(Boolean);

/* 中間CTAの位置決め。本文の見出し（h2）の中間地点にマーカーを1つだけ置く。
   会社ごとに本文の長さが違うので、位置は見出しの数から自動で求める。
   本文の実際の描画は ArticleLayout が行い、マーカーの位置に
   <slot name="mid-cta"> を差し込む。 */
const MID_MARK = '<!--mid-cta-->';

function withMidMarker(html) {
  if (!html) return html;
  const hits = [];
  const re = /<h2[\s>]/g;
  let m;
  while ((m = re.exec(html)) !== null) hits.push(m.index);
  /* 見出しが2つ以下の短い本文には入れない（末尾CTAと近くなりすぎるため） */
  if (hits.length < 3) return html;
  const at = hits[Math.floor(hits.length / 2)];
  return html.slice(0, at) + MID_MARK + html.slice(at);
}

const body = withMidMarker(rawBody);
---
<ArticleLayout
  page={{ ...page, keyPoints }}
  body={body}
  active={company.category}
  category={company.category}
  pageCss="page-review.css"
  breadcrumb={[
    { label: page.catTag, href: '/rankings/' + company.category + '.html' },
    { label: company.name }
  ]}
  cta={{ text: company.name, small: company.shortFeature || '', label: '公式サイトを見る', affId: company.id }}
>
  <section slot="before-body" class="info-box">
    <div class="label">この会社の要点</div>
    <table class="company-info-table" style="margin:8px 0 0;">
      <tbody>
        {company.specs.map((r) => (<tr><th>{r.label}</th><td>{r.value}</td></tr>))}
      </tbody>
    </table>
  </section>

  <div slot="mid-cta" class="mid-cta">
    <p class="mid-cta-lead"><strong>{company.name}</strong>の最新の料金・キャンペーンは公式サイトで確認できます。</p>
    <AffLink id={company.id} class="btn-cta" pos="review-mid">公式サイトを見る</AffLink>
  </div>

  <div slot="closing-cta" class="closing-cta">
    <p class="closing-cta-lead">
      <strong>{company.name}</strong>の料金・キャンペーンは変更されることがあります。申し込み前に公式サイトで最新の内容をご確認ください。
    </p>
    <div class="company-actions">
      <a href={'/rankings/' + company.category + '.html'} class="btn-secondary">他社と比較する</a>
      <AffLink id={company.id} class="btn-cta pulse" pos="review-bottom">公式サイトを見る</AffLink>
    </div>
  </div>
</ArticleLayout>
